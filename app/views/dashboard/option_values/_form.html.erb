<%= form_with model: [option_type, option_value],
              url: dashboard_option_type_option_values_path(option_type),
              method: :post,
              class: "mt-3" do |f| %>
  <div class="flex gap-2">
    <%= f.text_field :name,
                     placeholder: "New value (e.g. Red, XL)",
                     class: "flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm" %>
    <%= f.submit "Add", class: "px-3 py-2 bg-gray-800 text-white rounded-lg text-sm hover:bg-gray-700" %>
  </div>
  <% if f.object.errors.any? %>
    <p class="mt-1 text-red-600 text-sm"><%= f.object.errors.full_messages.to_sentence %></p>
  <% end %>
<% end %>