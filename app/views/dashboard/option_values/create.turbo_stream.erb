<%= turbo_stream.append "option_values_list_#{@option_type.id}" do %>
  <span id="option_value_<%= @option_value.id %>" class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-800">
    <%= @option_value.name %>
    <%= link_to "×", dashboard_option_type_option_value_path(@option_type, @option_value),
        class: "ml-2 text-gray-500 hover:text-red-600",
        data: {
          turbo_method: :delete,
          turbo_confirm: "Remove this value?"
        } %>
  </span>
<% end %>

<%= turbo_stream.replace "new_option_value_form_#{@option_type.id}" do %>
  <%= render "dashboard/option_values/form", option_type: @option_type, option_value: @option_type.option_values.build %>
<% end %>