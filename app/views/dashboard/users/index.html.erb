<main class="bg-gray-50 min-h-screen py-6 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto space-y-6">

    <!-- Enhanced Toolbar -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <%= form_with url: dashboard_users_path, method: :get, local: true, class: "space-y-4 md:space-y-0 md:flex md:flex-wrap md:items-end md:gap-4" do |form| %>
        
        <!-- Search -->
        <div class="md:flex-1">
          <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <%= form.text_field :query, 
                value: params[:query], 
                placeholder: "Search by name or email", 
                class: "block w-full pl-10 pr-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm transition-colors" %>
          </div>
        </div>

        <!-- Customer Group Filter -->
        <div class="min-w-[180px]">
          <label class="block text-sm font-medium text-gray-700 mb-1">Customer Group</label>
          <%= form.select :customer_group, 
              options_for_select(["All", "VIP", "Loyal", "New", "At-Risk", "Low Value"], params[:customer_group]),
              { prompt: "Select group" },
              class: "block w-full py-2.5 px-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm transition-colors text-sm" %>
        </div>

        <!-- Sort Field -->
        <div class="min-w-[180px]">
          <label class="block text-sm font-medium text-gray-700 mb-1">Sort By</label>
          <%= form.select :sort,
              options_for_select([
                ["Newest First", "created_at"],
                ["Name (A-Z)", "first_name"],
                ["Name (Z-A)", "first_name_desc"],
                ["Email (A-Z)", "email"],
                ["Email (Z-A)", "email_desc"],
                ["Most Orders", "orders_count_desc"],
                ["Fewest Orders", "orders_count"]
              ], params[:sort]),
              { prompt: "Select sort" },
              class: "block w-full py-2.5 px-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm transition-colors text-sm" %>
        </div>

        <!-- Direction -->
        <div class="min-w-[140px]">
          <label class="block text-sm font-medium text-gray-700 mb-1">Direction</label>
          <%= form.select :direction,
              options_for_select([["Descending", "desc"], ["Ascending", "asc"]], params[:direction]),
              class: "block w-full py-2.5 px-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm transition-colors text-sm" %>
        </div>

        <!-- Per Page -->
        <div class="min-w-[120px]">
          <label class="block text-sm font-medium text-gray-700 mb-1">Per Page</label>
          <%= form.select :per_page,
              options_for_select([5, 10, 25, 50, 100], params[:per_page]),
              class: "block w-full py-2.5 px-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm transition-colors text-sm" %>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-3 md:ml-auto">
          <%= form.submit "Apply Filters", 
              class: "px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm hover:shadow transition-colors" %>
          
          <% if params[:query].present? || params[:sort].present? || params[:direction].present? || params[:per_page].present? || params[:customer_group].present? %>
            <%= link_to "Reset Filters", dashboard_users_path, 
                class: "px-4 py-2.5 bg-white border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
          <% end %>
        </div>

        <!-- KMeans Actions -->
        <div class="flex flex-wrap gap-3 pt-2 md:pt-0 md:col-span-2">
          <%= link_to "Run KMeans", run_kmeans_dashboard_users_path, 
              data: { turbo_method: :post },
              class: "px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow-sm hover:shadow transition-colors" %>
          
          <%= link_to "Clear Segments", clear_customer_groups_dashboard_users_path, 
              data: { turbo_method: :post },
              class: "px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-lg shadow-sm hover:shadow transition-colors" %>
        </div>
      <% end %>
    </div>

    <!-- Users List -->
    <% if @users.any? %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="divide-y divide-gray-100">
          <% @users.each do |user| %>
            <div class="p-5 hover:bg-gray-50 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex items-start gap-4">
                  <!-- Avatar -->
                  <div class="flex-shrink-0">
                    <% if user.avatar.attached? %>
                      <%= image_tag user.avatar, class: "h-12 w-12 rounded-full object-cover" %>
                    <% else %>
                      <div class="h-12 w-12 rounded-full bg-blue-100 flex items-center justify-center">
                        <span class="text-blue-800 font-semibold">
                          <%= user.first_name&.first&.upcase || user.email[0].upcase %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                  
                  <!-- User Info -->
                  <div class="min-w-0">
                    <h3 class="text-sm font-semibold text-gray-900 truncate"><%= user.email %></h3>
                    <p class="text-sm text-gray-600 mt-1">
                      <%= [user.first_name, user.last_name].join(' ').presence || 'No name' %>
                    </p>
                    <p class="text-xs text-gray-500 mt-1">
                      Registered <time datetime="<%= user.created_at.strftime("%Y-%m-%d") %>"><%= user.created_at.strftime("%B %d, %Y") %></time>
                    </p>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <!-- Orders Badge -->
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= user.orders.any? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= user.orders.any? ? pluralize(user.orders.count, 'Order') : 'No Orders' %>
                  </span>

                  <!-- Customer Segment -->
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= case user.customer_group
                        when "VIP" then "bg-yellow-100 text-yellow-800"
                        when "Loyal" then "bg-green-100 text-green-800"
                        when "New" then "bg-blue-100 text-blue-800"
                        when "At-Risk" then "bg-red-100 text-red-800"
                        when "Low Value" then "bg-gray-100 text-gray-800"
                        else "bg-gray-200 text-gray-700"
                    end %>">
                    <%= user.customer_group.presence || "Unassigned" %>
                  </span>

                  <!-- Action Buttons -->
                  <div class="flex gap-2">
                    <%= link_to "View", dashboard_user_path(user), 
                        class: "inline-flex items-center px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
                    <%= link_to "Edit", edit_dashboard_user_path(user), 
                        class: "inline-flex items-center px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-100 rounded-lg hover:bg-blue-200 transition-colors" %>
                    <%= link_to "Delete", dashboard_user_path(user),
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this customer? This action cannot be undone." },
                        class: "inline-flex items-center px-3 py-1.5 text-xs font-medium text-red-700 bg-red-100 rounded-lg hover:bg-red-200 transition-colors" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Pagination -->
      <div class="mt-6">
        <%= paginate @users %>
      </div>

    <% else %>
      <!-- Empty State -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
        
        <h3 class="mt-4 text-lg font-semibold text-gray-900">No customers found</h3>
        <p class="mt-2 text-gray-600 max-w-md mx-auto">Try adjusting your search filters or add new customers to get started.</p>
      
      </div>
    <% end %>

  </div>
</main>