<%# Admin Dashboard - Order Detail Page %>
<main class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <%= link_to "← Back to Orders", dashboard_orders_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mb-6" %>

    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <!-- Order Header -->
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="text-lg leading-6 font-medium text-gray-900">Order #<%= @order.id %></h3>
            <p class="mt-1 max-w-2xl text-sm text-gray-500">Placed on <%= @order.created_at.strftime("%B %d, %Y") %></p>
          </div>
          <div class="mt-4 md:mt-0">
            <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-<%= order_status_color(@order.status) %>-100 text-<%= order_status_color(@order.status) %>-800">
              <%= @order.status&.humanize || 'Unknown Status' %>
            </span>
          </div>
        </div>
      </div>

      <!-- Order Summary Grid -->
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Customer</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @order.user&.email || 'Guest User' %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Total Amount</dt>
            <dd class="mt-1 text-sm text-gray-900">$<%= number_with_precision(@order.total_price, precision: 2) %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Payment Status</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @order.paid? ? 'Paid' : 'Pending' %></dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Tracking Number</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @order.tracking_number.presence || 'Not Available' %></dd>
          </div>
        </dl>
      </div>

      <!-- Customer & Shipping Information -->
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Customer & Shipping Details</h3>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <h4 class="text-md font-medium text-gray-700">Contact Information</h4>
            <p class="mt-1 text-sm text-gray-900"><%= @order.email %></p>
          </div>
          <div>
            <h4 class="text-md font-medium text-gray-700">Shipping Address</h4>
            <address class="mt-1 text-sm text-gray-900 not-italic">
              <span class="block"><%= @order.first_name %> <%= @order.last_name %></span>
              <span class="block"><%= @order.address %></span>
              <span class="block"><%= @order.city %>, <%= @order.state %> <%= @order.postal_code %></span>
              <span class="block"><%= @order.country %></span>
            </address>
          </div>
        </div>
      </div>

      <!-- Order Items Section -->
      <div class="px-4 py-5 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Items</h3>
        <% if @order.order_items.any? %>
          <div class="flow-root">
            <ul role="list" class="divide-y divide-gray-200">
              <% @order.order_items.includes(:product, :variant).each do |item| %>
                <li class="py-4">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 w-16 h-16 border border-gray-200 rounded-md overflow-hidden">
                      <% if item.variant&.image&.attached? %>
                        <%= image_tag item.variant.image, class: "w-full h-full object-center object-cover", alt: item.product.name %>
                      <% elsif item.product.image.attached? %>
                        <%= image_tag item.product.image, class: "w-full h-full object-center object-cover", alt: item.product.name %>
                      <% else %>
                        <%= image_tag "https://placehold.co/100x100?text=#{item.product.name}", class: "w-full h-full object-center object-cover", alt: item.product.name %>
                      <% end %>
                    </div>
                    <div class="ml-4 flex-1 min-w-0">
                      <p class="text-sm font-medium text-gray-900 truncate">
                        <%= link_to item.product.name, product_path(item.product), class: "hover:text-indigo-600" %>
                      </p>
                      <p class="text-sm text-gray-500 truncate">SKU: <%= item.product.id %></p>
                      <p class="text-sm text-gray-500"><%= item.variant&.option_values&.pluck(:name)&.join(', ') || '—' %></p>
                    </div>
                    <div class="ml-4 flex-shrink-0 text-right">
                      <p class="text-sm font-medium text-gray-900"><%= item.quantity %> x $<%= number_with_precision(item.price, precision: 2) %></p>
                      <p class="text-sm font-semibold text-gray-900 mt-1">$<%= number_with_precision(item.subtotal, precision: 2) %></p>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>

          <!-- Order Total Summary -->
          <div class="border-t border-gray-200 pt-4 mt-6 sm:ml-auto sm:w-1/2 lg:w-1/3">
            <dl class="space-y-2">
              <div class="flex items-center justify-between">
                <dt class="text-sm text-gray-600">Subtotal</dt>
                <dd class="text-sm font-medium text-gray-900">$<%= number_with_precision(@order.subtotal, precision: 2) %></dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-sm text-gray-600">Shipping</dt>
                <dd class="text-sm font-medium text-gray-900">$<%= number_with_precision(@order.shipping_cost, precision: 2) %></dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-sm text-gray-600">Tax</dt>
                <dd class="text-sm font-medium text-gray-900">$<%= number_with_precision(@order.tax, precision: 2) %></dd>
              </div>
              <div class="flex items-center justify-between border-t border-gray-200 pt-2">
                <dt class="text-base font-medium text-gray-900">Total</dt>
                <dd class="text-base font-medium text-gray-900">$<%= number_with_precision(@order.total_price, precision: 2) %></dd>
              </div>
            </dl>
          </div>
        <% else %>
          <p class="text-gray-500">No items found for this order.</p>
        <% end %>
      </div>
    </div>

    <!-- Update Order Form Section -->
    <div class="mt-8 bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Update Order</h3>
      </div>
      <div class="p-6">
        <%= form_with model: [:dashboard, @order], local: true, class: "space-y-6" do |form| %>
          <% if @order.errors.any? %>
            <div class="rounded-md bg-red-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800"><%= pluralize(@order.errors.count, "error") %> prohibited this order from being saved:</h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul role="list" class="list-disc pl-5 space-y-1">
                      <% @order.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
            <!-- Status -->
            <div class="sm:col-span-2">
              <%= form.label :status, class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :status, Order.statuses.keys.map { |status| [status.humanize, status] }, { include_blank: 'Select Status' }, class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md" %>
            </div>

            <!-- Tracking Number -->
            <div class="sm:col-span-2">
              <%= form.label :tracking_number, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :tracking_number, class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
            </div>

            <!-- Shipping Cost -->
            <div class="sm:col-span-1">
              <%= form.label :shipping_cost, class: "block text-sm font-medium text-gray-700" %>
              <%= form.number_field :shipping_cost, step: 0.01, class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
            </div>

            <!-- Tax -->
            <div class="sm:col-span-1">
              <%= form.label :tax, class: "block text-sm font-medium text-gray-700" %>
              <%= form.number_field :tax, step: 0.01, class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
            </div>
          </div>

          <div class="flex items-center justify-end">
            <%= form.submit "Update Order", class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>
