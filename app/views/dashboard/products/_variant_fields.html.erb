<div class="border p-4 rounded-md relative">
  <button type="button" class="absolute top-2 right-2 text-red-500 hover:text-red-700" onclick="this.closest('div').remove()">✕</button>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%= f.label :sku, "SKU", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :sku, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
    </div>
    <div>
      <%= f.label :price, "Price", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :price, step: "0.01", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
    </div>
    <div>
      <%= f.label :stock, "Stock", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :stock, min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
    </div>
  </div>

  <!-- For simplicity, we skip dynamic option assignment on create; can be added later -->
  <div class="mt-4">
    <h4 class="text-sm font-medium text-gray-700 mb-2">Options</h4>
    <div class="text-gray-500 text-sm">Will be assigned after product is created.</div>
  </div>

  <%= f.hidden_field :_destroy %>
</div>