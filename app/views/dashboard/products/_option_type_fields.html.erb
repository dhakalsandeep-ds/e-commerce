<div class="border p-4 rounded-md relative">
  <button type="button" class="absolute top-2 right-2 text-red-500 hover:text-red-700" onclick="this.closest('div').remove()">✕</button>

  <%= f.label :name, "Option Type Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
  <%= f.text_field :name, class: "block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>

  <div class="mt-3 space-y-2">
    <h4 class="text-sm font-medium text-gray-700">Values</h4>
    <div class="space-y-2">
      <%= f.fields_for :option_values do |ov| %>
        <div class="flex items-center space-x-2">
          <%= ov.text_field :name, placeholder: "e.g. Red, XL", class: "flex-1 rounded-md border-gray-300 shadow-sm sm:text-sm" %>
          <button type="button" class="text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">✕</button>
          <%= ov.hidden_field :_destroy %>
        </div>
      <% end %>
    </div>
    <button type="button" class="text-sm text-gray-600 hover:text-gray-900" onclick="addOptionValue(this, '<%= f.index %>')">
      + Add Value
    </button>
  </div>
  <%= f.hidden_field :_destroy %>
</div>