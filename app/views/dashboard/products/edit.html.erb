<%= form_with model: [:dashboard, @product],
              url: dashboard_product_path(@product),
              local: true,
              multipart: true,
              html: {
                class: "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8",
                "data-turbo": "false"
              } do |f| %>
  <!-- Header -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Edit Product</h1>
        <p class="mt-1 text-sm text-gray-500">Update details, media, and variants</p>
      </div>
      <div class="mt-4 sm:mt-0 flex space-x-3">
        <%= link_to "Cancel", dashboard_product_path(@product), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
        <%= f.submit "Save", class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700" %>
      </div>
    </div>
  </div>

  <% if @product.errors.any? %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg">
      <h3 class="font-bold"><%= pluralize(@product.errors.count, "error") %> prohibited saving:</h3>
      <ul class="list-disc pl-5 mt-2">
        <% @product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Product Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Product Information</h2>
        </div>
        <div class="p-6 space-y-6">
          <div>
            <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
          <div>
            <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.rich_text_area :description, class: "mt-1" %>
          </div>
          <div>
            <%= f.label :category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :category_id, Category.all, :id, :name, { include_blank: "None" }, { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" } %>
          </div>
        </div>
      </div>

      <!-- Media -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Media</h2>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Main Image -->
            <div>
              <%= f.label :image, "Main Image", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
                <div class="space-y-1 text-center" id="main-image-preview">
                  <% if @product.image.attached? %>
                    <div class="existing-image mb-2">
                      <%= image_tag @product.image, class: "mx-auto h-32 w-auto object-contain" %>
                    </div>
                  <% end %>
                  <svg class="mx-auto h-12 w-12 text-gray-400 main-placeholder <%= @product.image.attached? ? 'hidden' : '' %>" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="flex text-sm text-gray-600 mt-2">
                    <label for="product_image" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500">
                      <span><%= @product.image.attached? ? "Change" : "Upload" %> file</span>
                      <%= f.file_field :image, class: "sr-only", id: "product_image", accept: "image/*" %>
                    </label>
                    <p class="pl-1">or drag and drop</p>
                  </div>
                  <p class="text-xs text-gray-500">PNG, JPG, JPEG, WEBP up to 10MB</p>
                </div>
              </div>
            </div>

            <!-- Thumbnails -->
            <div>
              <%= f.label :thumbnails, "Additional Images", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
                <div class="space-y-1 text-center" id="thumbnails-preview">
                  <% if @product.thumbnails.attached? %>
                    <div class="existing-thumbnails mb-2 flex flex-wrap gap-1">
                      <% @product.thumbnails.each do |thumb| %>
                        <%= image_tag thumb, class: "w-16 h-16 rounded border-2 border-white object-cover" %>
                      <% end %>
                    </div>
                  <% end %>
                  <svg class="mx-auto h-12 w-12 text-gray-400 thumbnails-placeholder <%= @product.thumbnails.attached? ? 'hidden' : '' %>" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="flex text-sm text-gray-600 mt-2">
                    <label for="product_thumbnails" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500">
                      <span><%= @product.thumbnails.attached? ? "Add more" : "Upload" %> files</span>
                      <%= f.file_field :thumbnails, multiple: true, class: "sr-only", id: "product_thumbnails", accept: "image/*" %>
                    </label>
                    <p class="pl-1">or drag and drop</p>
                  </div>
                  <p class="text-xs text-gray-500">PNG, JPG, JPEG, WEBP up to 10MB each</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Variants Table -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Variants</h2>
        </div>
        <div class="p-6">
          <div class="overflow-x-auto -mx-6 px-6">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Combination</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Image</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Stock</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
              </thead>
              <tbody id="variants-table-body">
                <% if @product.variants.empty? %>
                  <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-gray-500">No variants</td>
                  </tr>
                <% else %>
                  <%= f.fields_for :variants do |vf| %>
                    <% variant = vf.object %>
                    <tr>
                      <td class="px-4 py-2 font-medium text-gray-900">
                        <%= variant.option_values.any? ? variant.option_values.map(&:name).join(' / ') : 'Simple' %>
                        <%= vf.hidden_field :id %>
                      </td>
                      <td class="px-4 py-2">
                        <div class="variant-image-upload">
                          <div class="flex justify-center px-2 py-2 border-2 border-gray-300 border-dashed rounded-md">
                            <div class="text-center variant-preview" data-variant-id="<%= variant.id %>">
                              <% if variant.image.attached? %>
                                <div class="existing-variant-image mb-1">
                                  <%= image_tag variant.image, class: "mx-auto h-10 w-auto object-contain" %>
                                </div>
                              <% end %>
                              <svg class="mx-auto h-6 w-6 text-gray-400 variant-placeholder <%= variant.image.attached? ? 'hidden' : '' %>" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                              <div class="mt-1 flex text-xs text-gray-600 justify-center">
                                <label for="variant_image_<%= variant.id %>" class="relative cursor-pointer font-medium text-blue-600 hover:text-blue-500">
                                  <span><%= variant.image.attached? ? "Change" : "Upload" %></span>
                                  <%= vf.file_field :image, accept: "image/*", class: "sr-only", id: "variant_image_#{variant.id}" %>
                                </label>
                              </div>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-2"><%= vf.text_field :sku, class: "w-full text-sm border rounded px-2 py-1", required: true %></td>
                      <td class="px-4 py-2"><%= vf.number_field :price, step: "0.01", class: "w-full text-sm border rounded px-2 py-1", required: true %></td>
                      <td class="px-4 py-2"><%= vf.number_field :stock, class: "w-full text-sm border rounded px-2 py-1", required: true %></td>
                      <td class="px-4 py-2 text-right">
                        <% if variant.persisted? %>
                          <%= link_to "×", "#", class: "text-red-600 hover:text-red-900", onclick: "removeVariant(this); return false;" %>
                          <%= vf.check_box :_destroy, { class: "hidden" }, "1", "0" %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Organization</h2>
        </div>
        <div class="p-6 space-y-4">
          <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status, [["Draft", "draft"], ["Active", "active"], ["Archived", "archived"]], {}, { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" } %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
// =============== MAIN IMAGE PREVIEW ===============
document.getElementById('product_image')?.addEventListener('change', function(e) {
  const preview = document.getElementById('main-image-preview');
  const placeholder = preview.querySelector('.main-placeholder');
  const existing = preview.querySelector('.existing-image');
  
  if (existing) existing.remove();
  if (placeholder) placeholder.classList.remove('hidden');
  
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(event) {
      const img = document.createElement('img');
      img.src = event.target.result;
      img.className = 'mx-auto h-32 w-auto object-contain';
      const wrapper = document.createElement('div');
      wrapper.className = 'existing-image mb-2';
      wrapper.appendChild(img);
      preview.insertBefore(wrapper, placeholder);
      placeholder.classList.add('hidden');
    };
    reader.readAsDataURL(file);
  }
});

// =============== THUMBNAILS PREVIEW ===============
document.getElementById('product_thumbnails')?.addEventListener('change', function(e) {
  const preview = document.getElementById('thumbnails-preview');
  const placeholder = preview.querySelector('.thumbnails-placeholder');
  const existing = preview.querySelector('.existing-thumbnails');
  
  if (existing) existing.remove();
  if (placeholder) placeholder.classList.remove('hidden');
  
  const files = e.target.files;
  if (files.length > 0) {
    const container = document.createElement('div');
    container.className = 'existing-thumbnails mb-2 flex flex-wrap gap-1';
    for (let i = 0; i < files.length; i++) {
      const reader = new FileReader();
      reader.onload = function(event) {
        const img = document.createElement('img');
        img.src = event.target.result;
        img.className = 'w-16 h-16 rounded border-2 border-white object-cover';
        container.appendChild(img);
      };
      reader.readAsDataURL(files[i]);
    }
    preview.insertBefore(container, placeholder);
    placeholder.classList.add('hidden');
  }
});

// =============== VARIANT IMAGE PREVIEW ===============
document.querySelectorAll('[id^="variant_image_"]').forEach(input => {
  input.addEventListener('change', function(e) {
    const variantId = this.id.replace('variant_image_', '');
    const preview = document.querySelector(`[data-variant-id="${variantId}"]`);
    const placeholder = preview.querySelector('.variant-placeholder');
    const existing = preview.querySelector('.existing-variant-image');
    
    if (existing) existing.remove();
    if (placeholder) placeholder.classList.remove('hidden');
    
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(event) {
        const img = document.createElement('img');
        img.src = event.target.result;
        img.className = 'mx-auto h-10 w-auto object-contain';
        const wrapper = document.createElement('div');
        wrapper.className = 'existing-variant-image mb-1';
        wrapper.appendChild(img);
        preview.insertBefore(wrapper, placeholder);
        placeholder.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    }
  });
});

// =============== REMOVE VARIANT ===============
function removeVariant(link) {
  const row = link.closest('tr');
  const destroyInput = row.querySelector('[name$="[_destroy]"]');
  if (destroyInput) {
    destroyInput.checked = true;
    row.style.opacity = '0.5';
    link.textContent = '✓';
  }
}
</script>