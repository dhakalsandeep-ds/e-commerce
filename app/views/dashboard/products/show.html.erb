<!-- Breadcrumbs -->
<nav class="flex p-4 text-sm text-gray-600" aria-label="Breadcrumb">
  <%= link_to "Products", dashboard_products_path, class: "hover:underline" %>
  <span class="mx-2">/</span>
  <span class="text-gray-900 font-medium truncate max-w-xs md:max-w-none"><%= @product.name %></span>
</nav>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @product.name %></h1>
      <div class="mt-2 flex flex-wrap gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
          ID: <%= @product.id %>
        </span>
      
        <span class="text-sm text-gray-500">
          Updated <%= time_ago_in_words(@product.updated_at) %> ago
        </span>
      </div>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Back", dashboard_products_path, class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
      <%= link_to "Edit", edit_dashboard_product_path(@product), class: "px-3 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700" %>
      <%= link_to "Delete", dashboard_product_path(@product), 
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this product?" }, 
          class: "px-3 py-2 text-sm font-medium text-white bg-red-600 border border-transparent rounded-md hover:bg-red-700" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Media -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-4">Media</h2>
          <div class="flex flex-col sm:flex-row gap-6">
            <!-- Main Image -->
            <div class="sm:w-2/3">
              <div class="bg-gray-100 rounded-lg overflow-hidden aspect-square flex items-center justify-center">
                <% if @product.image.attached? %>
                  <%= image_tag @product.image, class: "w-full h-full object-contain p-4" %>
                <% else %>
                  <span class="text-gray-400">No main image</span>
                <% end %>
              </div>
            </div>
            <!-- Thumbnails -->
            <div class="sm:w-1/3">
              <h3 class="text-sm font-medium text-gray-700 mb-2">Thumbnails</h3>
              <div class="flex flex-wrap gap-2">
                <% if @product.thumbnails.attached? %>
                  <% @product.thumbnails.each do |thumb| %>
                    <%= image_tag thumb.variant(resize_to_limit: [80, 80]), class: "w-16 h-16 object-cover rounded border" %>
                  <% end %>
                <% else %>
                  <span class="text-xs text-gray-400">None</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Description</h2>
        </div>
        <div class="p-6">
          <% if @product.description.present? %>
            <div class="prose max-w-none">
              <%= @product.description %>
            </div>
          <% else %>
            <p class="text-gray-500 italic">No description provided.</p>
          <% end %>
        </div>
      </div>

      <!-- Variants -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-medium text-gray-900">Variants</h2>
            <span class="px-2 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded">
              <%= @product.variants.count %> variant<%= 's' if @product.variants.count != 1 %>
            </span>
          </div>
        </div>
        <div class="p-6">
          <% if @product.variants.any? %>
            <div class="overflow-x-auto -mx-6 px-6">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Combination</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Stock</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% @product.variants.each do |variant| %>
                    <tr>
                      <td class="px-4 py-3 text-sm font-medium text-gray-900">
                        <%= variant.option_values.any? ? variant.option_values.map(&:name).join(' / ') : 'Simple' %>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-700"><%= variant.sku.presence || '—' %></td>
                      <td class="px-4 py-3 text-sm text-gray-700"><%= number_to_currency(variant.price) %></td>
                      <td class="px-4 py-3 text-sm">
                        <span class="font-medium"><%= variant.stock %></span>
                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium 
                          <%= variant.stock > 10 ? 'bg-green-100 text-green-800' : variant.stock > 0 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                          <%= variant.stock > 10 ? 'In Stock' : variant.stock > 0 ? 'Low Stock' : 'Out of Stock' %>
                        </span>
                      </td>
                      <td class="px-4 py-3 text-sm">
                        <% if variant.image.attached? %>
                          <span class="inline-flex items-center text-xs text-green-600">
                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Has image
                          </span>
                        <% else %>
                          <span class="text-xs text-gray-400">No image</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-gray-500 italic">No variants created.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Product Info -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Product Info</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <span class="text-xs font-medium text-gray-500 uppercase">Category</span>
            <p class="mt-1 text-sm font-medium text-gray-900">
              <%= @product.category&.name || '—' %>
            </p>
          </div>
          <div>
            <span class="text-xs font-medium text-gray-500 uppercase">Created</span>
            <p class="mt-1 text-sm text-gray-700">
              <%= @product.created_at.strftime("%b %d, %Y") %>
            </p>
          </div>
          <div>
            <span class="text-xs font-medium text-gray-500 uppercase">Last Updated</span>
            <p class="mt-1 text-sm text-gray-700">
              <%= @product.updated_at.strftime("%b %d, %Y at %I:%M %p") %>
            </p>
          </div>
        </div>
      </div>

      <!-- Options Summary -->
      <% used_option_types = @product.variants.joins(option_values: :option_type).distinct.pluck("option_types.name") %>
      <% if used_option_types.any? %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Options Used</h2>
          </div>
          <div class="p-6">
            <div class="flex flex-wrap gap-2">
              <% used_option_types.each do |name| %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= name %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Price Range Summary -->
      <% if @product.variants.any? %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Pricing Summary</h2>
          </div>
          <div class="p-6">
            <div class="space-y-2">
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Price Range</span>
                <p class="mt-1 text-lg font-semibold text-gray-900">
                  <%= number_to_currency(@product.variants.minimum(:price)) %>
                  –
                  <%= number_to_currency(@product.variants.maximum(:price)) %>
                </p>
              </div>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Total Stock</span>
                <p class="mt-1 text-lg font-semibold text-gray-900">
                  <%= @product.variants.sum(:stock) %>
                </p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>