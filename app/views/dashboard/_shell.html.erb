<!-- app/views/dashboard/_shell.html.erb -->
<div class="antialiased bg-gray-50 min-h-screen flex flex-col" data-controller="dashboard-shell">

  <div data-controller="mobile-sidebar">
    <!-- Sidebar Overlay -->
    <div
      class="fixed inset-0 bg-black/50 z-30 hidden"
      data-mobile-sidebar-target="overlay"
      data-action="click->mobile-sidebar#close"
    ></div>

    <!-- Top Navigation -->
    <nav class="bg-white border-b border-gray-200 px-4 py-2.5 fixed inset-x-0 top-0 z-50">
      <div class="flex justify-between items-center">
        <div class="flex items-center">
          <!-- Hamburger -->
          <button
            class="p-2 mr-2 text-gray-700 rounded-lg cursor-pointer md:hidden hover:text-gray-900 hover:bg-gray-100 z-50"
            data-action="click->mobile-sidebar#toggle"
            data-mobile-sidebar-target="menuButton"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 5h14M3 10h14M3 15h14" clip-rule="evenodd"></path>
            </svg>
          </button>

          <%= link_to dashboard_root_path, class: "flex items-center py-2.5" do %>
            <img src="https://flowbite.s3.amazonaws.com/logo.svg" class="h-6 mr-3 sm:h-7" alt="Logo"/>
            <span class="text-xl font-semibold text-gray-900">Admin Dashboard</span>
          <% end %>
        </div>

        <!-- Right Side: Icons and Profile -->
        <div class="flex items-center space-x-4">
          <!-- Search Icon -->
          <button class="p-2 text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-100">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
            </svg>
          </button>

          <!-- Notifications Icon -->
          <button class="p-2 text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-100 relative">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"></path>
            </svg>
            <span class="absolute top-0 right-0 flex items-center justify-center w-4 h-4 text-xs text-white bg-red-500 rounded-full">3</span>
          </button>

          <!-- Profile Dropdown -->
          <div class="relative" data-controller="dropdown">
            <button
              class="flex items-center text-sm rounded-full focus:ring-4 focus:ring-gray-300"
              data-action="click->dropdown#toggle click@window->dropdown#hide"
              data-dropdown-target="button"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <% if current_user&.avatar&.attached? %>
                <%= image_tag current_user.avatar, class: "w-8 h-8 rounded-full", alt: "User avatar" %>
              <% else %>
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center">
                  <span class="text-indigo-800 font-bold text-sm">
                    <%= current_user&.first_name&.first || current_user&.email&.first || 'U' %>
                  </span>
                </div>
              <% end %>
            </button>

            <div 
              class="hidden absolute right-0 z-50 mt-2 w-48 bg-white rounded-md shadow-lg py-1 ring-1 ring-black ring-opacity-5"
              data-dropdown-target="menu"
              role="menu"
            >
              <div class="px-4 py-3 border-b border-gray-100">
                <p class="text-sm text-gray-900 font-medium"><%= current_user&.first_name || 'User' %></p>
                <p class="text-xs text-gray-500 truncate"><%= current_user&.email %></p>
              </div>
              
              <%= link_to "#", class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                </svg>
                Profile
              <% end %>
              
              <%= link_to dashboard_settings_path, class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
                </svg>
                Settings
              <% end %>
              
              <div class="border-t border-gray-100"></div>
              
              <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414-1.414l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L10 7.414l2.293 2.293z" clip-rule="evenodd"></path>
                </svg>
                Sign out
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Sidebar -->
    <aside
      class="fixed top-0 left-0 w-64 h-screen pt-16 bg-white border-r border-gray-200 z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300"
      data-mobile-sidebar-target="sidebar"
    >
      <nav class="flex flex-col px-2 py-4 space-y-1 overflow-y-auto">
        <%= link_to dashboard_root_path, class: "px-2 py-2 text-sm font-medium rounded-md #{current_page?(dashboard_root_path) ? 'bg-gray-100 text-indigo-600' : 'hover:bg-gray-100'}" do %>
          <span>Dashboard</span>
        <% end %>

        <%= link_to dashboard_orders_path, class: "px-2 py-2 text-sm font-medium rounded-md #{current_page?(dashboard_orders_path) ? 'bg-gray-100 text-indigo-600' : 'hover:bg-gray-100'}" do %>
          <span>Orders</span>
        <% end %>

        <!-- Products Submenu -->
        <div data-controller="submenu">
          <button
            class="flex w-full items-center justify-between px-2 py-2 text-sm font-medium text-gray-600 rounded-md hover:bg-gray-100"
            data-action="click->submenu#toggle click@window->submenu#close"
            aria-expanded="false"
          >
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.858L17 15H7a1 1 0 01-.995-1.858L6 13l.005-.142A1 1 0 017 12h10a1 1 0 01.995.858L18 13v2a1 1 0 00.994 1.858L19 17v-1h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path>
              </svg>
              Products
            </span>
            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none">
              <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="max-h-0 overflow-hidden pl-4 mt-1 space-y-1 transition-[max-height] duration-300 ease-in-out">
            <%= link_to dashboard_products_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
              All Products
            <% end %>
            <%= link_to new_dashboard_product_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
              Add Product
            <% end %>
            <%= link_to dashboard_categories_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
              Collections
            <% end %>
            <a href="#" class="block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100">Inventory</a>
          </div>
        </div>

        <!-- Customers Submenu -->
        <div data-controller="submenu">
          <button
            class="flex w-full items-center justify-between px-2 py-2 text-sm font-medium text-gray-600 rounded-md hover:bg-gray-100"
            data-action="click->submenu#toggle click@window->submenu#close"
            aria-expanded="false"
          >
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
              </svg>
              Customers
            </span>
            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none">
              <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="max-h-0 overflow-hidden pl-4 mt-1 space-y-1 transition-[max-height] duration-300 ease-in-out">
            <%= link_to dashboard_users_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
              All Customers
            <% end %>
            <a href="#" class="block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100">Customer Groups</a>
          </div>
        </div>

        <!-- Marketing Submenu -->
<div data-controller="submenu">
  <button
    class="flex w-full items-center justify-between px-2 py-2 text-sm font-medium text-gray-600 rounded-md hover:bg-gray-100"
    data-action="click->submenu#toggle click@window->submenu#close"
    aria-expanded="false"
  >
    <span class="flex items-center">
      <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M12 2a1 1 0 01.967.744L14.146 7.2 13.047 14.01c-.04.27-.22.482-.438.54a.75.75 0 01-.727-.212L9 12l-1.885 2.338a.75.75 0 01-.727.212.65.65 0 01-.438-.54l-1.099-6.81L6.033 2.744A1 1 0 017 2h5zm-3.5 5a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path>
      </svg>
      Marketing
    </span>
    <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none">
      <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>
  <div class="max-h-0 overflow-hidden pl-4 mt-1 space-y-1 transition-[max-height] duration-300 ease-in-out">
    <%= link_to dashboard_discounts_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
      Discounts
    <% end %>
    <%= link_to dashboard_automations_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
      Automations
    <% end %>
    <%= link_to dashboard_campaigns_path, class: "block px-2 py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100" do %>
      Campaigns
    <% end %>
  </div>
</div>

        <%= link_to dashboard_settings_path, class: "px-2 py-2 text-sm font-medium rounded-md #{current_page?(dashboard_settings_path) ? 'bg-gray-100 text-indigo-600' : 'hover:bg-gray-100'}" do %>
          <span>Settings</span>
        <% end %>

        <%= link_to dashboard_reports_path, class: "px-2 py-2 text-sm font-medium rounded-md #{current_page?(dashboard_reports_path) ? 'bg-gray-100 text-indigo-600' : 'hover:bg-gray-100'}" do %>
          <span>Reports</span>
        <% end %>
      </nav>
    </aside>
  </div>

  <!-- Main Content -->
  <main class="flex-1 p-4 md:ml-64 pt-20">
    <!-- Page Header -->
    <div class="mb-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">sjaflsjdlfa<%= yield :page_title %></h1>
          <p class="mt-1 text-sm text-gray-500">sfjjaslfj<%= yield :page_subtitle %></p>
        </div>
        <div class="mt-4 md:mt-0">
        ajshdkhajsd create button  <%= yield :page_actions %>
        </div>
      </div>
    </div>

    <!-- Flash Messages -->
    <% if flash[:notice] %>
      <div class="rounded-md bg-green-50 p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="rounded-md bg-red-50 p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Main Content Yield -->
    <%= yield %>
  </main>
</div>