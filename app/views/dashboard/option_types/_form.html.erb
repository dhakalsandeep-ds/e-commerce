<div id="new_option_type_form">
  <%= form_with model: option_type,
                url: dashboard_option_types_path,
                method: :post,
                class: "space-y-4" do |f| %>
    
    <% if option_type.errors.any? %>
      <div class="p-3 bg-red-50 text-red-700 rounded text-sm">
        <ul class="list-disc pl-5">
          <% option_type.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, 
                       placeholder: "e.g. Size, Color, Material",
                       class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    </div>

    <div class="flex justify-end space-x-3 pt-2">
      <%= f.submit "Create Option Type", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    </div>
  <% end %>
</div>