<div id="option_type_<%= ot.id %>" class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 bg-gray-50 flex justify-between items-center">
    <h2 class="text-lg font-semibold text-gray-800"><%= ot.name %></h2>
    <%= link_to "Delete", dashboard_option_type_path(ot),
        class: "text-red-600 hover:text-red-800 text-sm",
        data: {
          turbo_method: :delete,
          turbo_confirm: "Delete this option type and all its values?"
        } %>
  </div>
  <div class="p-6">
    <div id="option_values_list_<%= ot.id %>">
      <div class="flex flex-wrap gap-2 mb-4">
        <% if ot.option_values.any? %>
          <% ot.option_values.each do |ov| %>
            <span id="option_value_<%= ov.id %>" class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-800">
              <%= ov.name %>
              <%= link_to "×", dashboard_option_type_option_value_path(ot, ov),
                  class: "ml-2 text-gray-500 hover:text-red-600",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Remove this value?"
                  } %>
            </span>
          <% end %>
        <% else %>
          <span class="text-gray-400 italic">No values yet</span>
        <% end %>
      </div>
    </div>

    <!-- Add Value Form -->
    <div id="new_option_value_form_<%= ot.id %>">
      <%= render "dashboard/option_values/form", option_type: ot, option_value: ot.option_values.build %>
    </div>
  </div>
</div>