<!-- app/views/dashboard/option_types/new.html.erb -->
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">New Option Type</h1>

  <%= form_with model: @option_type,
                url: dashboard_option_types_path,
                local: true,
                class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6" do |f| %>
    <% if @option_type.errors.any? %>
      <div class="mb-4 p-3 bg-red-50 text-red-700 rounded">
        <ul class="list-disc pl-5">
          <% @option_type.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, 
                       placeholder: "e.g. Size, Color, Material", 
                       class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    </div>

    <div class="flex justify-end space-x-3">
      <%= link_to "Cancel", dashboard_option_types_path, class: "px-4 py-2 text-gray-700" %>
      <%= f.submit "Create Option Type", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    </div>
  <% end %>
</div>