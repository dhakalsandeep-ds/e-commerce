
  <!-- Breadcrumbs -->
  <nav class="flex p-4 text-sm text-gray-600" aria-label="Breadcrumb">
    <span class="text-gray-500">Collections</span>
  </nav>

  <!-- Header: New Collection Button -->
  <div class="max-w-7xl mx-auto p-4">
    <%= link_to "New Collection", new_dashboard_collection_path,
                class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 mb-6" %>

    <!-- Collections Table -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-xs uppercase bg-gray-200 text-gray-600">
            <tr>
              <th scope="col" class="px-6 py-3">Title</th>
              <th scope="col" class="px-6 py-3">Handle</th>
              <th scope="col" class="px-6 py-3">Product Count</th>
              <th scope="col" class="px-6 py-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @collections.each do |collection| %>
              <tr class="border-b group hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-800"><%= collection.title %></td>
                <td class="px-6 py-4 text-sm text-gray-600"><%= collection.handle %></td>
                <td class="px-6 py-4 text-sm">
                  <%= collection.products.count %> <%= "product".pluralize(collection.products.count) %>
                </td>
                <td class="px-6 py-4 space-x-2 text-sm">
                  <%= link_to "Edit", edit_dashboard_collection_path(collection), class: "text-green-600 hover:underline" %>
                  <%= link_to "Delete", dashboard_collection_path(collection),
                              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                              class: "text-red-600 hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
