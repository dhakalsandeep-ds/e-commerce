<%# app/views/products/index.html.erb %>

<main class="bg-gray-50 dark:bg-gray-900 antialiased">
  <div class="max-w-screen-xl mx-auto px-4 py-8 md:py-12 2xl:px-0">

    <!-- Heading & Filters -->
    <div class="mb-4 md:mb-8 sm:flex sm:items-end sm:justify-between sm:space-y-0 space-y-4">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
          <li class="inline-flex items-center">
            <%= link_to "Home", root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary-600 dark:text-gray-400 dark:hover:text-white" %>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="h-5 w-5 text-gray-400 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/>
              </svg>
              <span class="ms-1 text-sm font-medium text-gray-500 md:ms-2 dark:text-gray-400">Products</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="flex items-center space-x-2">
        <!-- Sort Dropdown (Simplified Example) -->
        <div class="relative inline-block text-left">
          <div>
            <button type="button" class="group inline-flex w-full items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-600 dark:hover:text-white" id="sort-menu-button" aria-expanded="false" aria-haspopup="true">
              <svg class="-ms-0.5 me-2 h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M7 4l3 3M7 4 4 7m9-3h6l-6 6h6m-6.5 10 3.5-7 3.5 7M14 18h4" />
              </svg>
              Sort
              <svg class="-me-0.5 ms-2 h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" />
              </svg>
            </button>
          </div>
          <!-- Sort options would go here, typically in a dropdown menu -->
        </div>

        <!-- Filter Button (Triggers Modal) -->
        <button data-modal-target="filterModal" data-modal-toggle="filterModal" type="button" class="flex w-full items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-primary-700 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700 sm:w-auto">
          <svg class="-ms-0.5 me-2 h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M18.796 4H5.204a1 1 0 0 0-.753 1.659l5.302 6.058a1 1 0 0 1 .247.659v4.874a.5.5 0 0 0 .2.4l3 2.25a.5.5 0 0 0 .8-.4v-7.124a1 1 0 0 1 .247-.659l5.302-6.059c.566-.646.106-1.658-.753-1.658Z" />
          </svg>
          Filters
          <svg class="-me-0.5 ms-2 h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Product Grid -->
    <% if @products.any? %>
      <div class="mb-4 grid gap-4 sm:grid-cols-2 md:mb-8 lg:grid-cols-3 xl:grid-cols-4">
        <% @products.each do |product| %>
          <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="h-56 w-full flex items-center justify-center"> <!-- Added flex for centering -->
              <%= link_to product_path(product) do %>
                <% if product.image.attached? %>
                  <%= image_tag product.image, class: "object-contain h-full w-full dark:hidden", alt: product.name %>
                  <!-- Add dark mode image if needed -->
                <% else %>
                  <%= image_tag "https://placehold.co/300x200?text=#{product.name}", class: "object-contain h-full w-full dark:hidden", alt: product.name %>
                <% end %>
              <% end %>
            </div>
            <div class="pt-6">
              <div class="mb-4 flex items-center justify-between gap-4">
                <span class="me-2 rounded bg-primary-100 px-2.5 py-0.5 text-xs font-medium text-primary-800 dark:bg-primary-900 dark:text-primary-300">Up to 35% off</span>
                <div class="flex items-center">
                  <!-- Wishlist Button -->
                  <button type="button" data-tooltip-target="tooltip-add-to-favorites-<%= product.id %>" class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
                    <span class="sr-only">Add to Favorites</span>
                    <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6C6.5 1 1 8 5.8 13l6.2 7 6.2-7C23 8 17.5 1 12 6Z"/>
                    </svg>
                  </button>
                  <div id="tooltip-add-to-favorites-<%= product.id %>" role="tooltip" class="tooltip invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300 dark:bg-gray-700">
                    Add to favorites
                    <div class="tooltip-arrow" data-popper-arrow></div>
                  </div>

                  <!-- Quick Look Button -->
                  <button type="button" data-tooltip-target="tooltip-quick-look-<%= product.id %>" class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
                    <span class="sr-only">Quick look</span>
                    <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                      <path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z" />
                      <path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                  </button>
                  <div id="tooltip-quick-look-<%= product.id %>" role="tooltip" class="tooltip invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300 dark:bg-gray-700">
                    Quick look
                    <div class="tooltip-arrow" data-popper-arrow></div>
                  </div>
                </div>
              </div>

              <%= link_to product.name, product_path(product), class: "text-lg font-semibold leading-tight text-gray-900 hover:underline dark:text-white" %>

              <div class="mt-2 flex items-center gap-2">
                <div class="flex items-center">
                  <%= render 'shared/rating_stars', rating: product.average_rating || 4 %> <!-- Assuming a helper or partial for stars -->
                  <!-- <svg class="h-4 w-4 text-yellow-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg> -->
                </div>
                <p class="text-sm font-medium text-gray-900 dark:text-white"><%= product.reviews.count %> Reviews</p> <!-- Example dynamic data -->
              </div>

              <ul class="mt-2 flex items-center gap-3">
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h6l-6 6-6-6h6Z"/>
                  </svg>
                  <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Weight: <%= product.weight || 'N/A' %> kg</p> <!-- Example dynamic data -->
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 16H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v1m-9 9h10m-10-4h10m-10-4h10M9 3v4m0 0v4m0-4H7m2 0h2"/>
                  </svg>
                  <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Brand: <%= product.brand || 'Generic' %></p> <!-- Example dynamic data -->
                </li>
              </ul>

              <div class="mt-4 flex items-center justify-between gap-4">
                <p class="text-2xl font-extrabold leading-tight text-gray-900 dark:text-white">$<%= product.price || 'N/A' %></p> <!-- Example dynamic data -->
                <button type="button" class="inline-flex items-center rounded-lg bg-primary-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                  <svg class="-ms-1 me-2 h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h1.5L9 16m0 0h8m-8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8.5-3h9.25L19 7H7.312l-.75-3ZM3 5v12a1 1 0 0 0 1 1h1.05a2.5 2.5 0 0 1 4.9 0H10a1 1 0 0 0 1-1v-1m-5 0V9a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6.5"/>
                  </svg>
                  Add to cart
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pagination (Example using Kaminari or similar) -->
      <% if @pagy %>
        <%= render 'shared/pagy_nav', pagy: @pagy %> <!-- Assuming a partial for pagination -->
      <% elsif @products.respond_to?(:total_pages) %>
        <%= paginate @products %>
      <% end %>

    <% else %>
      <div class="text-center py-12">
        <p class="text-lg text-gray-700 dark:text-gray-300">No products found matching your criteria.</p>
        <!-- Optionally, add a button to reset filters -->
      </div>
    <% end %>

    <!-- Show More Button (if applicable) -->
    <!-- <div class="flex justify-center">
      <button type="button" class="rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-primary-700 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700">Show more</button>
    </div> -->

  </div>
</main>

<!-- Filter Modal Placeholder (Structure should be in a separate partial or view) -->
<!-- The modal structure from your snippet would go here, ideally in a separate file like app/views/shared/_filter_modal.html.erb -->
<div id="filterModal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-2xl max-h-full">
    <!-- Modal content -->
    <div class="relative rounded-lg shadow bg-white dark:bg-gray-800">
      <!-- Modal header -->
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Filters
        </h3>
        <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-toggle="filterModal">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close modal</span>
        </button>
      </div>
      <!-- Modal body -->
      <div class="p-4 md:p-5">
        <!-- Filter content goes here -->
        <p class="text-gray-500 dark:text-gray-400">Filter options would be implemented here. This is a placeholder.</p>
        <!-- Example filter section -->
        <div class="mb-4">
          <h6 class="mb-2 text-sm font-medium text-black dark:text-white">Brand</h6>
          <div class="space-y-2">
            <div class="flex items-center">
              <input id="brand-apple" type="checkbox" value="" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600">
              <label for="brand-apple" class="ms-2 text-sm font-medium text-gray-900 dark:text-gray-300">Apple</label>
            </div>
            <div class="flex items-center">
              <input id="brand-samsung" type="checkbox" value="" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600">
              <label for="brand-samsung" class="ms-2 text-sm font-medium text-gray-900 dark:text-gray-300">Samsung</label>
            </div>
            <!-- Add more brands -->
          </div>
        </div>
        <!-- Add more filter sections (Price, Color, Rating, etc.) -->
      </div>
      <!-- Modal footer -->
      <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
        <button data-modal-hide="filterModal" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Apply Filters</button>
        <button data-modal-hide="filterModal" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Reset</button>
      </div>
    </div>
  </div>
</div>

