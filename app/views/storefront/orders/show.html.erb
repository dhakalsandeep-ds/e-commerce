<%# Order Confirmation Page - Storefront %>
<style>
  @media print {
    body * { visibility: hidden; }
    .print-area, .print-area * { visibility: visible; }
    .print-area { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; }
  }
</style>

<main class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">

    <!-- Success Banner -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-4">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Thank you!</h1>
      <p class="mt-3 text-lg text-gray-600 max-w-md mx-auto">
        Your order has been confirmed.
     
      </p>
    </div>

    <!-- Order Summary Card -->
    <div class="print-area bg-white rounded-xl shadow-sm overflow-hidden mb-8">
      <div class="px-6 py-5 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900">
          Order #<span class="font-mono"><%= @order.id %></span>
        </h2>
        <p class="text-sm text-gray-500 mt-1">
          Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %>
        </p>
        <p class="text-sm text-gray-500 mt-1">
          Status: <span class="font-medium capitalize"><%= @order.status || 'pending' %></span>
        </p>
      </div>

      <div class="p-6">
        <!-- Order Items -->
        <ul class="space-y-5">
          <% @order.order_items.includes(:product, :variant).each do |item| %>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-20 h-20 rounded-md bg-gray-100 overflow-hidden">
                <% if item.product.image.attached? %>
                  <%= image_tag item.product.image, class: "w-full h-full object-cover", alt: item.product.name %>
                <% else %>
                  <%= image_tag "https://placehold.co/80x80?text=#{item.product.name.truncate(10)}", class: "w-full h-full object-cover", alt: item.product.name %>
                <% end %>
              </div>
              <div class="ml-4 flex-1">
                <h3 class="font-medium text-gray-900"><%= item.product.name %></h3>
                <p class="text-sm text-gray-500 mt-1">
                  <% if item.variant %>
                    <%= item.variant.option_values.pluck(:name).join(', ') %>
                  <% else %>
                    —
                  <% end %>
                </p>
                <div class="mt-2 flex items-center justify-between">
                  <span class="text-sm text-gray-500">Qty: <%= item.quantity %></span>
                  <span class="font-medium text-gray-900">
                    $<%= number_with_precision(item.price * item.quantity, precision: 2) %>
                  </span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>

        <!-- Order Totals -->
        <div class="mt-8 pt-6 border-t border-gray-200">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-gray-600">Subtotal</dt>
              <dd class="font-medium text-gray-900">
                $<%= number_with_precision(@order.subtotal, precision: 2) %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-600">Shipping</dt>
              <dd class="font-medium text-gray-900">
                $<%= number_with_precision(@order.shipping_cost, precision: 2) %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-600">Tax</dt>
              <dd class="font-medium text-gray-900">
                $<%= number_with_precision(@order.tax, precision: 2) %>
              </dd>
            </div>
            <div class="flex justify-between pt-4 border-t border-gray-200 text-lg font-bold">
              <dt>Total</dt>
              <dd>$<%= number_with_precision(@order.total_price, precision: 2) %></dd>
            </div>
          </dl>
        </div>

        <!-- Shipping Address -->
        <div class="mt-8 pt-6 border-t border-gray-200">
          <h3 class="font-medium text-gray-900">Shipping Address</h3>
          <address class="mt-2 not-italic text-sm text-gray-600">
            <%= @order.first_name %> <%= @order.last_name %><br>
            <%= @order.address %><br>
            <%= @order.city %>, <%= @order.state %> <%= @order.postal_code %><br>
            <%= @order.country %>
          </address>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="text-center space-y-4 sm:space-y-0 sm:space-x-4 sm:flex sm:justify-center">
      <%= link_to "Continue Shopping", products_path, class: "w-full sm:w-auto px-6 py-3 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition" %>
      <%= link_to "View Order History", user_dashboard_orders_path, class: "block px-6 py-3 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800" %>
      <%= link_to "Print Receipt", "#", onclick: "window.print(); return false;", class: "w-full sm:w-auto px-6 py-3 bg-white border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition" %>
    </div>
  </div>
</main>
