<% content_for :head, "Products | MyApp" %>

<main class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">

    <!-- Etsy-Style Filters -->
    <div class="mb-8">

      <!-- Category Filters -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6 pb-3 border-b border-gray-200">
        <%= link_to "All",
            products_path(params.permit(:min_price, :max_price, :sort, :in_stock, :free_shipping).merge(category_id: nil)),
            class: "text-sm font-medium transition-colors whitespace-nowrap #{params[:category_id].blank? ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-700 hover:text-blue-600'}" %>

        <% @categories.each do |category| %>
          <%= link_to category.name,
              products_path(params.permit(:min_price, :max_price, :sort, :in_stock, :free_shipping).merge(category_id: category.id)),
              class: "text-sm font-medium transition-colors whitespace-nowrap #{params[:category_id].to_s == category.id.to_s ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-700 hover:text-blue-600'}" %>
        <% end %>
      </div>

      <!-- Price & Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

        <!-- Price Filter Form -->
        <%= form_with url: products_path, method: :get, local: true, class: "flex flex-wrap items-center gap-3" do |f| %>
          <% # Preserve all current filters as hidden fields %>
          <% [:category_id, :sort, :in_stock, :free_shipping].each do |param| %>
            <% if params[param].present? %>
              <%= hidden_field_tag param, params[param] %>
            <% end %>
          <% end %>

          <!-- Min Price -->
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">$</span>
            <%= f.number_field :min_price, value: params[:min_price], min: 0, step: 0.01,
                placeholder: "Min",
                class: "pl-7 pr-3 py-2 w-24 text-sm border border-gray-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
          </div>

          <!-- Max Price -->
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">$</span>
            <%= f.number_field :max_price, value: params[:max_price], min: 0, step: 0.01,
                placeholder: "Max",
                class: "pl-7 pr-3 py-2 w-24 text-sm border border-gray-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
          </div>

          <!-- Buttons -->
          <%= f.submit "Apply", class: "px-4 py-2 text-sm font-medium bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors shadow-sm" %>
          <%= link_to "Clear", products_path(category_id: params[:category_id]),
              class: "px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors" %>
        <% end %>

        <!-- Sort Dropdown -->
        <%= form_with url: products_path, method: :get, local: true, html: { class: "flex items-center gap-2" } do |f| %>
          <% allowed_filter_params = params.slice(:category_id, :min_price, :max_price, :in_stock, :free_shipping) %>
          <% allowed_filter_params.each do |key, value| %>
            <% if value.is_a?(Array) %>
              <% value.each do |v| %>
                <%= hidden_field_tag "#{key}[]", v %>
              <% end %>
            <% else %>
              <%= hidden_field_tag key, value %>
            <% end %>
          <% end %>
          <label for="sort" class="text-sm text-gray-700">Sort by:</label>
          <%= f.select :sort,
                [
                  ['Featured', ''],
                  ['Price: Low to High', 'price_asc'],
                  ['Price: High to Low', 'price_desc'],
                  ['Name: A–Z', 'name_asc'],
                  ['Name: Z–A', 'name_desc']
                ],
                { selected: params[:sort] },
                {
                  id: "sort",
                  class: "text-sm border border-gray-300 rounded-md px-2.5 py-2 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none",
                  onchange: "this.form.submit()"
                } %>
        <% end %>

      </div>
    </div>

    <!-- Active Filters -->
    <% active_filters = [] %>
    <% if params[:category_id].present? %>
      <% category = @categories.detect { |c| c.id.to_s == params[:category_id].to_s } %>
      <% if category %>
        <% url = products_path(params.except(:category_id).permit(:min_price, :max_price, :sort, :in_stock, :free_shipping, :page)) %>
        <% active_filters << { label: "Category", value: category.name, remove_url: url } %>
      <% end %>
    <% end %>
    <% if params[:min_price].present? %>
      <% url = products_path(params.except(:min_price).permit(:category_id, :max_price, :sort, :in_stock, :free_shipping, :page)) %>
      <% active_filters << { label: "Min", value: "$#{params[:min_price]}", remove_url: url } %>
    <% end %>
    <% if params[:max_price].present? %>
      <% url = products_path(params.except(:max_price).permit(:category_id, :min_price, :sort, :in_stock, :free_shipping, :page)) %>
      <% active_filters << { label: "Max", value: "$#{params[:max_price]}", remove_url: url } %>
    <% end %>
    <% if params[:sort].present? %>
      <% url = products_path(params.except(:sort).permit(:category_id, :min_price, :max_price, :in_stock, :free_shipping, :page)) %>
      <% sort_label = { 'price_asc' => 'Price ↑', 'price_desc' => 'Price ↓', 'name_asc' => 'Name A–Z', 'name_desc' => 'Name Z–A' }[params[:sort]] %>
      <% active_filters << { label: "Sort", value: sort_label, remove_url: url } if sort_label %>
    <% end %>

    <% if active_filters.any? %>
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <span class="text-sm font-medium text-gray-700">Filtered by:</span>
        <% active_filters.each do |filter| %>
          <a href="<%= filter[:remove_url] %>"
             class="inline-flex items-center gap-1.5 text-sm text-blue-600 hover:text-blue-800 group font-medium"
             aria-label="Remove filter: <%= filter[:label] %>">
            <span><%= filter[:label] %>: <%= filter[:value] %></span>
            <svg class="w-3 h-3 opacity-60 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </a>
        <% end %>
      </div>
    <% end %>

    <!-- Product Grid -->
    <% if @products.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        <% @products.each do |product| %>
          <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col h-full border border-gray-100 group">
            <a href="<%= product_path(product) %>" class="block flex-1 flex flex-col">
              <div class="relative overflow-hidden">
                <% if product.image.attached? %>
                  <%= image_tag product.image, class: "h-72 w-full object-cover group-hover:scale-105 transition-transform duration-500", alt: product.name %>
                <% else %>
                  <div class="h-72 w-full bg-gray-200 flex items-center justify-center">
                    <span class="text-gray-500 text-2xl font-bold">
                      <%
                        words = product.name.to_s.strip.split
                        if words.size >= 2
                          initials = "#{words[0].first}#{words[1].first}".upcase
                        else
                          initials = words[0]&.first&.upcase || "–"
                        end
                      %>
                      <%= initials %>
                    </span>
                  </div>
                <% end %>
                <% if product.created_at >= 3.days.ago %>
                  <div class="absolute top-3 left-3">
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-orange-500 to-red-500 text-white">
                      New
                    </span>
                  </div>
                <% end %>
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <h3 class="text-lg font-semibold text-gray-900 line-clamp-2 group-hover:text-blue-600 transition-colors">
                  <%= product.name %>
                </h3>
                <p class="text-sm text-gray-500 mt-1">
                  <%= product&.category&.name %>
                </p>
                <div class="mt-auto pt-3">
                  <% min_price = product.min_variant_price.to_f %>
                  <% if min_price > 0 %>
                    <p class="text-lg font-bold text-gray-900">
                      $<%= number_with_precision(min_price, precision: 2) %>
                    </p>
                  <% else %>
                    <p class="text-gray-500 italic">Price on request</p>
                  <% end %>
                </div>
                <div class="mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="inline-flex items-center text-sm font-medium text-blue-600">
                    View details
                    <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @products.total_pages > 1 %>
        <div class="mt-10 flex justify-center">
          <%= paginate @products %>
        </div>
      <% end %>

    <% else %>
      <!-- Empty State -->
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-5">
          <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">No products found</h3>
        <p class="text-gray-600 max-w-md mx-auto mb-6">Try adjusting your filters or browse all items.</p>
        <div class="flex justify-center gap-3">
          <%= link_to "Reset filters", products_path, class: "px-5 py-2.5 text-sm font-medium bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
        </div>
      </div>
    <% end %>

  </div>
</main>