<%# Storefront Contact Page - Saves to DB | Nepal-Specific Data in English %>

<% content_for :title, "Contact Us" %>

<main class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Flash Messages -->
    <% if notice %>
      <div class="mb-6 max-w-3xl mx-auto">
        <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded-r-lg">
          <p class="text-sm text-green-700 font-medium"><%= notice %></p>
        </div>
      </div>
    <% elsif alert %>
      <div class="mb-6 max-w-3xl mx-auto">
        <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-r-lg">
          <p class="text-sm text-red-700 font-medium"><%= alert %></p>
        </div>
      </div>
    <% end %>

    <!-- Page Header -->
    <div class="pb-5 border-b border-gray-200">
      <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl">Contact Us</h1>
      <p class="mt-2 max-w-4xl text-sm text-gray-500">
        Have questions? We're here to help. Send us a message and we'll respond as soon as possible.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <div class="bg-white shadow sm:rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h2 class="text-lg font-medium text-gray-900">Send us a message</h2>

            <!-- Form -->
            <%= form_with model: ContactMessage.new, url: contact_path, method: :post, local: true, class: "mt-6 space-y-6", scope: :contact_message do |form| %>
              <!-- Error Messages -->
              <% if @contact_message&.errors&.any? %>
                <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 rounded-r-lg">
                  <div class="text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @contact_message.errors.full_messages.each do |msg| %>
                        <li><%= msg %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>

              <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                <!-- Name -->
                <div class="sm:col-span-3">
                  <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_field :name, 
                      value: @contact_message&.name,
                      class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
                </div>

                <!-- Email -->
                <div class="sm:col-span-3">
                  <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
                  <%= form.email_field :email, 
                      value: @contact_message&.email,
                      class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
                </div>

                <!-- Subject -->
                <div class="sm:col-span-6">
                  <%= form.label :subject, class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_field :subject, 
                      value: @contact_message&.subject,
                      class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
                </div>

                <!-- Message -->
                <div class="sm:col-span-6">
                  <%= form.label :message, "Message", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_area :message, 
                      value: @contact_message&.message,
                      rows: 4,
                      class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div class="flex justify-end">
                <%= form.submit "Send Message", class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Contact Info (Right Sidebar - Nepal Specific, in English) -->
      <div class="lg:col-span-1">
        <div class="bg-white shadow sm:rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h2 class="text-lg font-medium text-gray-900">Get in touch</h2>
            
            <div class="mt-6 space-y-6">
              <!-- Address -->
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-gray-900">Address</h3>
                  <p class="mt-1 text-sm text-gray-500">
                    Thapathali, Kathmandu 44600<br>
                    Bagmati Province<br>
                    Nepal
                  </p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-gray-900">Phone</h3>
                  <p class="mt-1 text-sm text-gray-500">
                    +977 9841234567 (Mobile)<br>
                    +977 1-4225678 (Landline)
                  </p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-gray-900">Email</h3>
                  <p class="mt-1 text-sm text-gray-500">
                    support@yourbrand.com.np<br>
                    info@yourbrand.com.np
                  </p>
                </div>
              </div>

              <!-- Business Hours -->
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-gray-900">Business Hours</h3>
                  <p class="mt-1 text-sm text-gray-500">
                    Sunday – Friday: 10:00 AM – 6:00 PM<br>
                    Saturday: 10:00 AM – 2:00 PM<br>
                    (Nepal Time, UTC+5:45)
                  </p>
                </div>
              </div>
            </div>

            <!-- Social Media -->
            <div class="mt-8">
              <h3 class="text-sm font-medium text-gray-900">Follow us</h3>
              <div class="mt-3 flex space-x-6">
                <a href="#" class="text-gray-400 hover:text-gray-500">
                  <span class="sr-only">Facebook</span>
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                    <!-- Facebook icon -->
                  </svg>
                </a>
                <a href="#" class="text-gray-400 hover:text-gray-500">
                  <span class="sr-only">Instagram</span>
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                    <!-- Instagram icon -->
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Map Placeholder -->
       <!-- Google Map - Kathmandu, Nepal -->
