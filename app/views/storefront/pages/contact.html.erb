  <div class="px-4 py-5 sm:p-6">
    <h2 class="text-lg font-medium text-gray-900">Our Location</h2>
    <div class="mt-4 aspect-video w-full overflow-hidden rounded-lg border border-gray-200">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3532.481655075553!2d85.32078657593368!3d27.69412527620457!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39eb18f80f8a4f8d%3A0x3b5a6a8b5b5b5b5b!2sThapathali%2C%20Kathmandu%2044600!5e0!3m2!1sen!2snp!4v1718000000000!5m2!1sen!2snp"
        width="100%"
