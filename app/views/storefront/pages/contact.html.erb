        referrerpolicy="no-referrer-when-downgrade"
        title="Brand Store Location in Thapathali, Kathmandu">
      </iframe>
    </div>
    <p class="mt-3 text-sm text-gray-500 text-center">
      Thapathali, Kathmandu, Nepal
    </p>
  </div>
</div>
      </div>
    </div>
  </div>
</main>