<h1>All Products</h1>
<nav>
  <%= link_to "Home", root_path %>
  <%= link_to "Shop", shop_path %>
  <% if current_user&.admin? %>
    <%= link_to "Admin", dashboard_products_path %>
  <% end %>
</nav>
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
  <% @products.each do |product| %>
    <div class="border rounded-lg overflow-hidden shadow-sm">
      <% if product.image.attached? %>
        <%= image_tag product.image.variant(resize_to_limit: [300, 200]), class: "w-full h-48 object-cover" %>
      <% end %>
      <div class="p-4">
        <h3 class="font-semibold text-gray-800"><%= product.name %></h3>
        <p class="text-lg text-blue-600"><%= number_to_currency(product.price) %></p>
        <%= link_to "View Details", shop_product_path(product), class: "text-sm text-blue-600 hover:underline" %>
      </div>
    </div>
  <% end %>
</div>

<%= paginate @products %>