<!-- app/views/devise/mailer/reset_password_instructions.html.erb -->
<div style="font-family: Arial, sans-serif; color: #333; line-height: 1.5; max-width: 600px; margin: 0 auto; border: 1px solid #ddd; padding: 20px; border-radius: 8px; background-color: #f9f9f9;">
  
  <!-- Logo -->
  <div style="text-align: center; margin-bottom: 20px;">
    <%= image_tag 'logo.svg', alt: 'Your Company', style: 'max-width: 150px; height: auto;' %>
  </div>

  <!-- Greeting -->
  <h2 style="color: #0b79d0; text-align: center;">Reset Your Password</h2>

  <p>Hello <strong><%= @resource.email %></strong>,</p>

  <p>We received a request to reset your password. Click the button below to create a new password:</p>

  <!-- Reset Button -->
  <div style="text-align: center; margin: 20px 0;">
    <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" 
       style="background-color:#0b79d0; color:white; padding:12px 25px; text-decoration:none; border-radius:5px; font-weight:bold;">
       Change My Password
    </a>
  </div>

  <p>If you did not request a password reset, you can safely ignore this email. Your password will not change.</p>

  <hr style="border: none; border-top: 1px solid #ddd; margin: 20px 0;">

  <p style="font-size: 12px; color: #666; text-align: center;">
    © <%= Time.current.year %> Your Company. All rights reserved.
  </p>
</div>
