<%# app/views/devise/passwords/new.html.erb %>

<main class="bg-gray-50 min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- Card container -->
    <div class="bg-white shadow-lg rounded-xl p-8">

  <!-- Logo -->
  <div class="flex justify-center mb-6">
    <%= link_to root_path, class: "flex items-center" do %>
      <%= image_tag "lis.svg", class: "h-20 w-auto", alt: "Brand Store Logo" %>
    <% end %>
  </div>

  <!-- Title -->
  <h2 class="text-center text-3xl font-extrabold text-gray-900 mb-4">
    Forgot your password?
  </h2>
  <p class="text-center text-sm text-gray-600 mb-6">
    Enter your email below and we'll send you instructions to reset your password.
  </p>

  <!-- Error Messages -->
  <%= render "devise/shared/error_messages", resource: resource %>

  <!-- Reset Password Form -->
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, class: "space-y-6") do |f| %>
    <!-- Email Field -->
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-black focus:border-black sm:text-sm" %>
      </div>
    </div>

    <!-- Submit Button -->
    <div>
      <%= f.submit "Send reset instructions", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-black hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black" %>
    </div>
  <% end %>

  <!-- Back to Sign In Link -->
  <div class="mt-6 text-center">
    <%= link_to "Back to sign in", new_session_path(resource_name), class: "font-medium text-black hover:text-gray-700" %>
  </div>
  
</div>

  </div>
</main>

