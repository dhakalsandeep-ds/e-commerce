<aside
  class="fixed top-0 left-0 w-64 h-screen bg-white border-r border-gray-200 z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300"
  data-mobile-sidebar-target="sidebar"
>
  <!-- Logo / Header -->
  <div class="flex items-center justify-center h-28 border-b border-gray-200 px-4">
    <%= link_to dashboard_root_path, class: "flex items-center" do %>
      <%= image_tag "logoss.svg", class: "h-20 w-auto sm:h-24", alt: "Clotherya Logo" %>
    <% end %>
  </div>

  <!-- Navigation -->
  <nav class="flex flex-col flex-1 overflow-y-auto px-2 py-4 space-y-2">

    <!-- Dashboard -->
    <%= link_to dashboard_root_path,
        class: "flex items-center px-4 py-2 text-sm font-medium rounded-md #{current_page?(dashboard_root_path) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors'}" do %>
      <!-- Custom Dashboard Icon -->
      <svg class="w-5 h-5 mr-3 text-gray-400" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M12,23 C5.92486775,23 1,18.0751322 1,12 C1,5.92486775 5.92486775,1 12,1 C18.0751322,1 23,5.92486775 23,12 C23,18.0751322 18.0751322,23 12,23 Z M12,21 C16.9705627,21 21,16.9705627 21,12 C21,7.02943725 16.9705627,3 12,3 C7.02943725,3 3,7.02943725 3,12 C3,16.9705627 7.02943725,21 12,21 Z M11,2.99895656 C11,2.44724809 11.4438648,2 12,2 C12.5522847,2 13,2.44266033 13,2.99895656 L13,4.00104344 C13,4.55275191 12.5561352,5 12,5 C11.4477153,5 11,4.55733967 11,4.00104344 L11,2.99895656 Z M17.0197148,4.46201308 C17.3743461,4.03937987 18.0018518,3.98207877 18.4278761,4.33955557 C18.8509508,4.69455736 18.909384,5.32144067 18.5518036,5.7475883 L17.9076746,6.51523139 C17.5530432,6.9378646 16.9255375,6.9951657 16.4995133,6.6376889 C16.0764386,6.2826871 16.0180054,5.6558038 16.3755857,5.22965617 L17.0197148,4.46201308 Z M20.6906492,9.45217746 C21.233976,9.35637429 21.7515057,9.71583199 21.8480775,10.2635182 C21.9439808,10.8074125 21.5857904,11.3251931 21.0379455,11.421793 L20.0510826,11.5958035 C19.5077558,11.6916067 18.9902261,11.332149 18.8936543,10.7844628 C18.797751,10.2405685 19.1559414,9.72278784 19.7037863,9.62618802 L20.6906492,9.45217746 Z M20.2951323,15.6344963 C20.7729258,15.9103506 20.9383216,16.5183728 20.660254,17 C20.3841117,17.4782926 19.7768989,17.6446952 19.2951323,17.3665471 L18.4272996,16.8655037 C17.949506,16.5896494 17.7841102,15.9816272 18.0621778,15.5 C18.3383202,15.0217074 18.9455329,14.8553048 19.4272996,15.1334529 L20.2951323,15.6344963 Z M16.0182308,20.116194 C16.2069262,20.6346303 15.9427976,21.2067168 15.4202014,21.3969262 C14.9012235,21.5858187 14.3291101,21.3229817 14.1388455,20.8002342 L13.7961116,19.8585806 C13.6074162,19.3401442 13.8715449,18.7680578 14.394141,18.5778483 C14.9131189,18.3889558 15.4852324,18.6517928 15.6754969,19.1745403 L16.0182308,20.116194 Z M9.86115445,20.8002342 C9.67245904,21.3186706 9.10239469,21.5871356 8.57979857,21.3969262 C8.06082066,21.2080337 7.7915047,20.6389414 7.98176921,20.116194 L8.32450311,19.1745