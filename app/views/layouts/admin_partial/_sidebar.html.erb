      </svg>
      Dashboard
    <% end %>

    <!-- Orders -->
    <%= link_to dashboard_orders_path,
        class: "flex items-center px-4 py-2 text-sm font-medium rounded-md #{current_page?(dashboard_orders_path) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors'}" do %>
      <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M3 3h18v4H3V3zm0 7h18v11H3V10z" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Orders
    <% end %>

    <!-- Products Submenu -->
    <div data-controller="submenu" <%= 'data-open="true"' if request.path.starts_with?('/dashboard/products') || request.path.starts_with?('/dashboard/categories') || request.path == '/dashboard/option_types' %>>
      <button
        class="flex w-full items-center justify-between px-4 py-2 text-sm font-medium text-gray-700 rounded-md hover:bg-gray-100"
        data-action="click->submenu#toggle click@window->submenu#closeIfOutside"
        aria-expanded="false"
      >
        <span class="flex items-center">
          <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Products
        </span>
        <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none">
          <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <div
        class="overflow-hidden transition-[max-height] duration-300 ease-in-out pl-8 mt-1 space-y-1 <%= request.path.starts_with?('/dashboard/products') || request.path.starts_with?('/dashboard/categories') || request.path == '/dashboard/option_types' ? 'max-h-96' : 'max-h-0' %>"
        data-submenu-target="submenu"
        data-action="click->submenu#ignoreClick"
      >
        <%= link_to dashboard_products_path, class: "block px-2 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-100" do %>
          All Products
        <% end %>
        <%= link_to new_dashboard_product_path, class: "block px-2 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-100" do %>
          Add Product
        <% end %>
        <%= link_to dashboard_categories_path, class: "block px-2 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-100" do %>
          Categories
        <% end %>
        <%= link_to dashboard_option_types_path, class: "block px-2 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-100" do %>
          Product Options
        <% end %>
      </div>
    </div>

    <!-- Customers Submenu -->
    <div data-controller="submenu" <%= 'data-open="true"' if request.path.starts_with?('/dashboard/users') %>>
      <button
        class="flex w-full items-center justify-between px-4 py-2 text-sm font-medium text-gray-700 rounded-md hover:bg-gray-100"
        data-action="click->submenu#toggle click@window->submenu#closeIfOutside"
        aria-expanded="false"
      >
        <span class="flex items-center">
          <svg class="w-5 h-5 mr-3 text-gray-400" viewBox="0 0 1024 1024" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M687 479.8c-12.7-6.2-25.7-11.8-38.9-16.6 49.8-40.3 81.6-101.8 81.6-170.6 0-12.6-1.1-24.9-3.1-36.9h78.2v-73.1H700.2c-38-65.4-108.9-109.4-189.8-109.4-121 0-219.4 98.4-219.4 219.4 0 68.9 31.9 130.5 81.7 170.7-154.2 56.4-264.6 204.5-264.6 378h73.1c0-181.5 147.7-329.1 329.1-329.1 50.7 0 99.3 11.2 144.5 33.3l32.2-65.7z m-80.3-297.2H414c25.8-22.6 59.5-36.3 96.3-36.3 36.9 0 70.6 13.7 96.4 36.3z m-237.9 73.1H652c3.1 11.8 4.7 24.1 4.7 36.9 0 80.7-65.6 146.3-146.3 146.3s-146.3-65.6-146.3-146.3c0-12.8 1.6-25.1 4.7-36.9zM731.5 548.7c-101 0-182.9 81.9-182.9 182.9s81.9 182.9 182.9 182.9 182.9-81.9 182.9-182.9c-0.1-101-81.9-182.9-182.9-182.9z m0 292.6c-60.5 0-109.7-49.2-109.7-109.7S671 621.9 731.5 621.9s109.7 49.2 109.7 109.7S792 841.3 731.5 841.3z"/>
            <path d="M758.9 655.7H704V743l69.4 68.8 38.6-39-53.1-52.7z"/>
          </svg>
          Customers
        </span>
        <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none">
          <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <div
        class="overflow-hidden transition-[max-height] duration-300 ease-in-out pl-8 mt-1 space-y-1 <%= request.path.starts_with?('/dashboard/users') ? 'max-h-60' : 'max-h-0' %>"
        data-submenu-target="submenu"
        data-action="click->submenu#ignoreClick"
      >
        <%= link_to dashboard_users_path, class: "block px-2 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-100" do %>
          All Customers
        <% end %>
        <!-- ✅ ADD CUSTOMER LINK -->
        <%= link_to new_dashboard_user_path, class: "block px-2 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-100" do %>
          Add Customer
        <% end %>
      </div>
    </div>
  </nav>
</aside>