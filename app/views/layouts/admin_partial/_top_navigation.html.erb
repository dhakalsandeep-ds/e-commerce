<div class="md:ml-64 bg-white sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-end items-center h-16">

      <!-- Profile -->
      <div class="relative" data-controller="dropdown">
        <button class="flex items-center rounded-full focus:ring-2 focus:ring-indigo-500 transition"
                data-action="click->dropdown#toggle click@window->dropdown#hide">
          <% if current_user&.avatar&.attached? %>
            <%= image_tag current_user.avatar, class: "w-10 h-10 rounded-full", alt: "User avatar" %>
          <% else %>
            <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
              <span class="text-indigo-800 font-bold text-sm">
                <%= current_user&.first_name&.first || current_user&.email&.first || 'U' %>
              </span>
            </div>
          <% end %>
        </button>

        <!-- Dropdown Menu -->
        <div class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-1 ring-1 ring-black ring-opacity-5"
             data-dropdown-target="menu" role="menu">
          <div class="px-4 py-3 border-b border-gray-100">
            <p class="text-sm font-medium text-gray-900"><%= current_user&.first_name || 'User' %></p>
            <p class="text-xs text-gray-500 truncate"><%= current_user&.email %></p>
          </div>
       
         
          <div class="border-t border-gray-100"></div>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
        </div>
      </div>

    </div>
  </div>
</div>
