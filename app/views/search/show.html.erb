<% content_for :head, "Search Results for '#{@query}' | Clotherya" %>

<main class="bg-gray-50 min-h-screen pt-16 pb-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">

    <!-- Search Header -->
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <% if @query.present? %>
            <h1 class="text-2xl font-bold text-gray-900">
              Search results for "<span class="text-blue-600"><%= @query %></span>"
            </h1>
            <p class="text-gray-600 mt-1">
              <%= pluralize(@products.count, "product") %> found
            </p>
          <% else %>
            <h1 class="text-2xl font-bold text-gray-900">Search Products</h1>
            <p class="text-gray-600 mt-1">Enter a keyword to find items</p>
          <% end %>
        </div>

      </div>
    </div>

    <!-- Results -->
    <% if @query.present? %>
      <% if @products.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          <% @products.each do |product| %>
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-all overflow-hidden border border-gray-100 group">
              <a href="<%= product_path(product) %>" class="block">
                <div class="h-72 w-full bg-gray-200 relative">
                  <% if product.image.attached? %>
                    <%= image_tag product.image, class: "h-72 w-full object-cover", alt: product.name %>
                  <% end %>
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-semibold text-gray-900 line-clamp-2"><%= product.name %></h3>
                  <p class="text-sm text-gray-500 mt-1"><%= product&.category&.name %></p>

                  <!-- Variant-Based Pricing -->
                  <% min_price = product.min_variant_price %>
                  <% if min_price.present? %>
                    <p class="text-lg font-bold mt-2">$<%= number_with_precision(min_price, precision: 2) %></p>
                  <% else %>
                    <p class="text-gray-500 italic mt-2">Price on request</p>
                  <% end %>
                </div>
              </a>
            </div>
          <% end %>
        </div>

        <% if @products.total_pages > 1 %>
          <div class="mt-10 flex justify-center">
            <%= paginate @products %>
          </div>
        <% end %>

      <% else %>
        <!-- No Results -->
        <div class="bg-white rounded-2xl p-12 text-center border border-gray-200">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-5">
            <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">No products found</h3>
          <p class="text-gray-600 mb-6">Try different keywords or browse categories.</p>
          <%= link_to "Browse All Products", products_path, class: "px-5 py-2.5 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
        </div>
      <% end %>
    <% else %>
      <!-- Empty search -->
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">Search for anything</h3>
        <p class="mt-2 text-gray-600">Start typing in the search bar above</p>
      </div>
    <% end %>

  </div>
</main>
