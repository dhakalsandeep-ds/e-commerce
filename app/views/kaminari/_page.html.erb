<% if page.current? %>
  <li>
    <span class="px-3 py-1 font-medium text-blue-600 border border-transparent bg-white rounded-md"><%= page %></span>
  </li>
<% else %>
  <li>
    <%= link_to page, url,
        class: "px-3 py-1 text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-blue-700 rounded-md" %>
  </li>
<% end %>